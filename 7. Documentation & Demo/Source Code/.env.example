# AdForge AI — Environment Configuration
# Copy this file to .env and fill in your credentials.

# Groq API Key — obtain from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Flask secret key — generate a random string for production
FLASK_SECRET_KEY=change_this_to_a_random_secret_key

# Set to "production" in live deployments
FLASK_ENV=development
